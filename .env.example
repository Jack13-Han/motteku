# Optional Firebase: if omitted, Motteku runs in browser-local demo mode.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Optional for bag photos: copy the exact bucket from Firebase Console > Storage > Files.
# Group chat text, replies and reactions use Firestore and do not need Storage.
# New buckets normally end in .firebasestorage.app; legacy buckets may end in .appspot.com.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional AI advice. Keep this key server-side only; never use NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
