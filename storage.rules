rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /sharedTrips/{tripId}/bags/{fileName} {
      // Preserve the existing shared bag/photo permissions.
      allow read: if request.auth != null
        && firestore.exists(/databases/(default)/documents/sharedTrips/$(tripId)/members/$(request.auth.uid));
      allow create, update: if request.auth != null
        && firestore.exists(/databases/(default)/documents/sharedTrips/$(tripId)/members/$(request.auth.uid))
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    match /users/{userId}/tripCovers/{tripId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Chat is text-only. Unmatched chat photo paths have no read or write access.
  }
}
