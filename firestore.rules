rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/workspace/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /sharedTrips/{tripId} {
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.inviteCode is string;
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/sharedTrips/$(tripId)/members/$(request.auth.uid));
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/sharedTrips/$(tripId)/members/$(request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bagPlan']);
      allow delete: if false;
      match /members/{memberId} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/sharedTrips/$(tripId)/members/$(request.auth.uid));
        allow create: if request.auth != null && request.auth.uid == memberId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.inviteCode == get(/databases/$(database)/documents/sharedTrips/$(tripId)).data.inviteCode;
        allow update, delete: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/sharedTrips/$(tripId)).data.ownerUid;
      }
      match /messages/{messageId} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/sharedTrips/$(tripId)/members/$(request.auth.uid));
        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/sharedTrips/$(tripId)/members/$(request.auth.uid))
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }
  }
}
